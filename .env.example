# Obtain the value from BotFather. Do not commit your real token.
BOT_TOKEN=

# Telegram usernames whose documents the bot must ignore. Do not include @.
EXCLUDED_USERNAMES=Anastasia_ipoteka,andrey_ipoteka

# Telegram ID of the manager who receives client feedback in a private chat.
MANAGER_USER_ID=1680647231

# Public channels to monitor, comma-separated (without @).
NEWS_CHANNELS=

# Create these at https://my.telegram.org. Keep real values only in .env.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Google Drive is optional. Keep it false until one-time authorization is complete.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CLIENT_FILE=secrets/google-oauth-client.json
GOOGLE_DRIVE_TOKEN_FILE=secrets/google-oauth-token.json
GOOGLE_DRIVE_ROOT_NAME=Mortgage AI — Сделки (бот)
